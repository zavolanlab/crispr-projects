/*
========================================================================================
    lincorfz/nextflow.config
    De novo lincRNA annotation and Ribo-seq / polysome-based prioritization of lincRNA ORFs
========================================================================================
*/

params {
    // ---------------------------------------------------------------- inputs
    rnaseq_tsv        = null   // sample, condition, bam, sj_tab   (stranded F2R1 paired-end RNA-seq)
    riboseq_tsv       = null   // sample, bam                      (genomic Ribo-seq alignments, indexed)
    polysome_tsv      = null   // path, fraction, n_ribosomes, replicate, strand (plus/minus)
    genome            = null   // genome FASTA (with .fai)
    chrom_sizes       = null
    reference_gtf     = null   // GENCODE comprehensive annotation
    conservation_dir  = null   // PhyloCSF+1..3 / -1..3, PhyloCSF_Power, PhyloP100way, PhyloP30way bigwigs
    noncode_gtf       = ''     // optional: NONCODE lncRNA GTF (overlap ids are reported)
    hcc_orfs_gtf      = ''     // optional: HCC Ribo-seq paper nORF GTF (overlap with tissue lincRNA ORFs)
    peptide_tables    = ''     // optional: comma-separated peptide identification tables
    rnaseq_tracks_tsv = ''     // optional: label, strand, path of RNA-seq bigwigs to add to the IGV session
    igv_reference_annotation = '' // optional: (indexed) reference GTF to show in the IGV session

    chromosomes       = 'all'  // 'all' (chr1-22, X, Y) or comma-separated list, e.g. 'chr20' for tests
    primary_condition = 'HepG2'

    // ---------------------------------------------------------------- run layout
    rundir         = './run_01'
    outdir         = "${params.rundir}/results"
    workdir_param  = "${params.rundir}/work"
    conda_envs_dir = "${params.rundir}/conda_envs"   // pre-built with setup_conda_envs.sh
    publish_mode   = 'copy'

    // ---------------------------------------------------------------- polysome MRL
    mrl_min_ribosomes      = 1      // 80S
    mrl_max_ribosomes      = 10     // decasome
    mrl_min_total_coverage = 10     // min summed replicate-mean coverage over fractions to report MRL(x)
    mrl_per_replicate      = true
    polysome_min_mean_coverage = 1.0 // per-nt summed coverage required for isoform/ORF-level MRL

    // ---------------------------------------------------------------- Ribo-seq P-sites
    ribo_min_len    = 25
    ribo_max_len    = 36
    ribo_max_clip5  = 5
    ribo_min_offset = 8
    ribo_max_offset = 20
    ribo_min_frame0 = 0.45
    junction_min_unique_reads = 2   // RNA-seq support for junctions of spliced Ribo-seq reads

    // ---------------------------------------------------------------- de novo assembly / lincRNA selection
    stringtie_args       = '-f 0.05 -j 2 -c 2'
    stringtie_merge_args = ''
    min_tx_length        = 200
    min_tpm              = 1.0
    min_tpm_monoexonic   = 5.0
    min_junction_reads   = 3
    min_isoform_fraction = 0.1
    utr_extension_distance    = 1000
    keep_pc_gene_exon_overlap = false
    keep_pc_intronic          = false

    // ---------------------------------------------------------------- expression
    featurecounts_strand    = 2     // reverse-stranded (F2R1) libraries
    sanity_min_total_counts = 10

    // ---------------------------------------------------------------- ORFs
    min_aa              = 8
    start_codons        = 'ATG'
    near_cognate_codons = ''        // e.g. 'CTG,GTG,TTG'
    min_psites_orf      = 1

    // ---------------------------------------------------------------- ranking
    p_strong            = 1e-3
    min_inframe_strong  = 10
    min_frac_inframe_strong = 0.5
    min_reps_strong     = 2
    p_moderate          = 1e-2
    min_inframe_moderate = 5
    p_weak              = 5e-2
    min_frac_unique     = 0.1   // below: class 'multimapping' (signal dominated by multimapping reads)
    w_mrl    = 0.25
    w_ribo   = 0.20
    w_island = 0.10
    w_expr   = 0.20
    w_cons   = 0.10
    w_unique = 0.15
    w_pep    = 0.05
    gtf_min_evidence = 'weak'      // strong > moderate > weak > multimapping > none
    igv_locus        = 'chr20:49278178-49299600'   // ZFAS1
}

workDir = "${params.workdir_param}"

// -------------------------------------------------------------------------------------
//  PROFILES
// -------------------------------------------------------------------------------------
profiles {
    conda {
        conda.enabled  = true
        conda.cacheDir = "${params.conda_envs_dir}"
    }
}

// -------------------------------------------------------------------------------------
//  EXECUTOR (sciCORE SLURM)
// -------------------------------------------------------------------------------------
executor {
    name      = 'slurm'
    queueSize = 50
    submitRateLimit = '20/1min'
}

// -------------------------------------------------------------------------------------
//  PROCESS RESOURCES & LABELS (QoS chosen to match the requested time, see sciCORE docs)
// -------------------------------------------------------------------------------------
process {
    cpus   = 1
    memory = '4 GB'
    time   = '30m'
    clusterOptions = '--qos=30min'

    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : (task.attempt < 2 ? 'retry' : 'terminate') }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = '30m'
        clusterOptions = '--qos=30min'
    }
    withLabel: process_medium {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = '6h'
        clusterOptions = '--qos=6hours'
    }
    withLabel: process_medium_low_cpu {
        cpus   = 1
        memory = { 24.GB * task.attempt }
        time   = '6h'
        clusterOptions = '--qos=6hours'
    }
    withLabel: process_high {
        cpus   = 16
        memory = { 48.GB * task.attempt }
        time   = '6h'
        clusterOptions = '--qos=6hours'
    }

    // tool environments (pre-built, see setup_conda_envs.sh)
    withLabel: env_py {
        conda = "${params.conda_envs_dir}/lincorfz_py"
    }
    withLabel: env_tools {
        conda = "${params.conda_envs_dir}/lincorfz_tools"
    }
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}
