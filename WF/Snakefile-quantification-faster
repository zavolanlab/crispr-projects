rule separate_BED_pas_into_chromosomes:
    """
        separate BED_pas into chromosomes, for less memory consumption
    """
    input:
        BED_pas = config['tandem_pas'],
    output:
        BED_pas_per_chr=os.path.join(
            config["output_dir"],
            "PAQR",
            config["organism"],
            "tandem_PAS_catalogue_per_chromosome","{chr}.bed"),    
    params:
        outdir = os.path.join(config["output_dir"],"PAQR",config["organism"],"tandem_PAS_catalogue_per_chromosome"),
        chr = "{chr}",
    threads: 1
    log:
        os.path.join(config["local_log"],"separate_BED_pas_into_chromosomes_{chr}.log"),
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        awk -F"\\t" '$1=="{params.chr}" {{print $0}}' {input.BED_pas} > {output.BED_pas_per_chr}; \
        touch {output.BED_pas_per_chr}; \
        ) &> {log}""" 

rule separate_bam_into_chromosomes:
    """
        separate .bam file into chromosomes, for less memory consumption 
    """
    input:
        bam=os.path.join(
                        config["output_dir"],
                        "samples",
                        "{sample}",
                        "map_genome",
                        "{sample}.Aligned.sortedByCoord.uniquely_mapped.bam"),

        bai=os.path.join(
                        config["output_dir"],
                        "samples",
                        "{sample}",
                        "map_genome",
                        "{sample}.Aligned.sortedByCoord.uniquely_mapped.bam"),
    output:
        chr_specific_bam=os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "map_genome",
            "over_chrs",
            "{sample}.{chr}.bam"),
        chr_specific_bai = os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "map_genome",
            "over_chrs",
            "{sample}.{chr}.bam.bai"),
    params:
        sample = "{sample}",
        outdir = os.path.join(config["output_dir"],"samples","{sample}","map_genome","over_chrs"),
        chr = "{chr}",
    conda:
        "envs/samtools_latest.yaml"
    threads: 6
    resources:
        mem_mb=20000,
        runtime=60,
    log:
        os.path.join(config["local_log"],"separate_bam_into_chromosomes_{sample}_{chr}.log"),
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        rm -f {params.outdir}/{params.chr}.non_sorted.bam; \
        samtools view -bo {params.outdir}/{params.chr}.non_sorted.bam {input.bam} {params.chr}; \
        samtools sort -@ {threads} {params.outdir}/{params.chr}.non_sorted.bam > {params.outdir}/{params.sample}.{params.chr}.bam; \
        samtools index -@ {threads} {params.outdir}/{params.sample}.{params.chr}.bam; \
        touch {params.outdir}/{params.sample}.{params.chr}.bam; \
        rm {params.outdir}/{params.chr}.non_sorted.bam; \
        ) &> {log}"""

rule PAQ_create_coverages:
    """
    Extracting the coverages of poly(A) sites from the alignment
    """
    input:
        BAM_alignment = os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "map_genome",
            "over_chrs",
            "{sample}.{chr}.bam"),
        BAI_alignment_index = os.path.join(
            config["output_dir"],
            "samples",
            "{sample}",
            "map_genome",
            "over_chrs",
            "{sample}.{chr}.bam.bai"),
        BED_pas_per_chr = os.path.join(config["output_dir"],"PAQR",config["organism"],"tandem_PAS_catalogue_per_chromosome","{chr}.bed"),
        SCRIPT_ = os.path.join(workflow.basedir, "scripts", "paqr","create-pas-coverages.py"),

    output:
        PKL_pas_coverage = os.path.join(config["output_dir"],"PAQR",config["organism"],"coverages","{sample}.{chr}.pkl"),
        PKL_wig_plus = os.path.join(config["output_dir"],"PAQR",config["organism"],"coverages","{sample}.{chr}.plus.wig"),
        PKL_wig_minus = os.path.join(config["output_dir"],"PAQR",config["organism"],"coverages","{sample}.{chr}.minus.wig"),
        TSV_extensions = os.path.join(config["output_dir"],"PAQR",config["organism"],"extensions","{sample}.{chr}.extensions.tsv")
    params:
        outdir_coverages = os.path.join(config["output_dir"],"PAQR",config["organism"],"coverages"),
        outdir_extensions = os.path.join(config["output_dir"],"PAQR",config["organism"],"extensions"),
        INT_coverage_downstream_extension = config['PAQ_coverage_downstream_extension'],
        INT_min_distance_start_to_proximal = config['PAQ_min_distance_start_to_proximal'],
        STR_unstranded_flag = lambda wildcards:
            "--unstranded" if config['PAQ_coverage_unstranded'] == "yes" else "",
    threads: 6
    resources:
        mem_mb=5000,
        runtime=10,
    log:
        os.path.join(config["local_log"],"PAQ_create_coverages_{sample}_{chr}_.log")

    singularity:
        "docker://zavolab/mapp_base_python:1.1.1"

    shell:
        """
        (mkdir -p {params.outdir_coverages}; \
        mkdir -p {params.outdir_extensions}; \
        python {input.SCRIPT_} \
        --bam {input.BAM_alignment} \
        --cluster {input.BED_pas_per_chr} \
        --ds_extension {params.INT_coverage_downstream_extension} \
        --min_dist_exStart2prox {params.INT_min_distance_start_to_proximal} \
        --processors {threads} \
        --pickle_out {output.PKL_pas_coverage} \
        --extensions_out {output.TSV_extensions} \
        {params.STR_unstranded_flag}) \
        &> {log}
        """

