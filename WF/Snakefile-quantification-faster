rule rmats_all_samples:
    input:
        bams=expand(os.path.join(
                        config["output_dir"],
                        "samples",
                        "{sample}",
                        "map_genome",
                        "{sample}.Aligned.sortedByCoord.uniquely_mapped.bam"),
                  sample = list(samples.index)),
        gtf = config['gtf_file'],
    params:
        outdir = os.path.join(config['output_dir'], "AS_quantification", config["organism"],"rmats"),
        tmpdir = os.path.join(config['output_dir'], "AS_quantification", config["organism"],"rmats","tmp"),
        b1 = os.path.join(config['output_dir'], "AS_quantification", config["organism"],"rmats","b1.txt"),
        libType = "fr-firststrand", 
        # THAT actually corresponds to ISR in Salmon terminology, so first read is reversed relative to original RNA sequence. 
        # To be changed accordingly, if the library prep would be different
        readLength = "100",
    output:
        summary_txt = os.path.join(config['output_dir'], "AS_quantification", config["organism"],"rmats","summary.txt"),
    conda:
        "envs/rmats.yaml"
    threads: 16
    resources:
        mem_mb=100000,
        runtime=1000,
    log:
        os.path.join(config["local_log"],"rmats_all_samples.log")
    shell:
        """(set +o pipefail; mkdir -p {params.outdir} {params.tmpdir}; \
        echo "{input.bams}" | tr ' ' ',' > {params.b1}; \
        rmats.py --b1 {params.b1} --gtf {input.gtf} \
        --od {params.outdir} --tmp {params.tmpdir} \
        -t paired --libType {params.libType} \
        --readLength {params.readLength} --variable-read-length \
        --nthread {threads} \
        --novelSS --allow-clipping --individual-counts \
        --statoff;) &> {log}"""


