rule make_stranded_coverage:
    """
        use samtools depth
        only look at paired reads
        rely on sam flags for strandedness
    """
    input:
        bam=os.path.join(
                        config["output_dir"],
                        "samples",
                        "{sample}",
                        "map_genome",
                        "{sample}.Aligned.sortedByCoord.uniquely_mapped.bam"),
        chrom_sizes = config["chrom_sizes"]
    output:
        minus_bw = os.path.join(
                        config["output_dir"],
                        "genomic_coverage",
                        "{sample}.minus.bigwig"),
        plus_bw = os.path.join(
                        config["output_dir"],
                        "genomic_coverage",
                        "{sample}.plus.bigwig"),
    params:
        outdir = os.path.join(
            config["output_dir"],
            "genomic_coverage"),
    conda:
        "envs/samtools_latest.yaml"
    threads: 4
    resources:
        mem_mb=40000,
        runtime=240,
    log:
        os.path.join(config["local_log"],"make_stranded_coverage_{sample}.log"),
    shell:
        """
        set +o pipefail
        mkdir -p {params.outdir}
        
        # Create an isolated temporary directory for this specific sample's run
        TMPDIR=$(mktemp -d)
        trap "rm -rf $TMPDIR" EXIT
        
        echo "Processing {wildcards.sample} (Raw depth)..." > {log}

        # 1. Isolate strands (expects F2R1 library orientation)
        # 1.1 gene is on positive strand
        samtools view -b -f 81 {input.bam} > $TMPDIR/r1_rev.bam 2>> {log}
        samtools view -b -f 129 -F 16 {input.bam} > $TMPDIR/r2_fwd.bam 2>> {log}
        samtools merge -f -@ {threads} $TMPDIR/plus_strand.bam $TMPDIR/r1_rev.bam $TMPDIR/r2_fwd.bam 2>> {log}
        echo "Isolated reads from genes on positive strand..." > {log}
        
        # 1.2 gene is on negative strand
        samtools view -b -f 65 -F 16 {input.bam} > $TMPDIR/r1_fwd.bam 2>> {log}
        samtools view -b -f 145 {input.bam} > $TMPDIR/r2_rev.bam 2>> {log}
        samtools merge -f -@ {threads} $TMPDIR/minus_strand.bam $TMPDIR/r1_fwd.bam $TMPDIR/r2_rev.bam 2>> {log}
        echo "Isolated reads from genes on negative strand..." > {log}
        
        # 2. Depth calculation, Chromosome Filtering, and Sorting
        # The awk command reads {input.chrom_sizes} first, then the '-' tells it to read the samtools pipe.
        samtools depth -s $TMPDIR/plus_strand.bam | \
            awk -v OFS='\\t' 'NR==FNR {{valid_chroms[$1]=1; next}} $1 in valid_chroms {{print $1, $2-1, $2, $3}}' {input.chrom_sizes} - | \
            LC_COLLATE=C sort -k1,1 -k2,2n > $TMPDIR/plus.bedgraph
        
        echo "Prepared sorted bedgraph for positive strand..." > {log}
        
        samtools depth -s $TMPDIR/minus_strand.bam | \
            awk -v OFS='\\t' 'NR==FNR {{valid_chroms[$1]=1; next}} $1 in valid_chroms {{print $1, $2-1, $2, $3}}' {input.chrom_sizes} - | \
            LC_COLLATE=C sort -k1,1 -k2,2n > $TMPDIR/minus.bedgraph

        echo "Prepared sorted bedgraph for negative strand..." > {log}
        
        # 3. Convert to BigWig
        bedGraphToBigWig $TMPDIR/plus.bedgraph {input.chrom_sizes} {output.plus_bw}
        bedGraphToBigWig $TMPDIR/minus.bedgraph {input.chrom_sizes} {output.minus_bw}        
        echo "Successfully generated BigWigs for {wildcards.sample}!" >> {log}
        """